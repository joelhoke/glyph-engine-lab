{
  "name": "pretext-next",
  "private": true,
  "scripts": {
    "identity:sync": "node scripts/sync-collaborate-identity.mjs",
    "identity:check": "node scripts/sync-collaborate-identity.mjs --check",
    "prebuild": "npm run identity:sync",
    "dev": "next dev --webpack",
    "dev:clean": "rm -rf .next node_modules/.cache && next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "verify:collaborate-api": "npm run identity:check && node scripts/verify-collaborate-api.js",
    "verify:vibe-memento": "node scripts/verify-vibe-memento.js",
    "verify:vibe-session-store": "node scripts/verify-vibe-session-store.js",
    "verify:intro-reveal": "node scripts/verify-intro-reveal.js",
    "verify:creations-api": "node scripts/verify-creations-api.js"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "border-beam": "^1.3.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "20.14.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.62.1",
    "sharp": "^0.35.4",
    "typescript": "5.6.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
